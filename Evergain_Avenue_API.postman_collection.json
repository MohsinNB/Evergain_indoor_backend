{
  "info": {
    "_postman_id": "e9a8b7c6-d5e4-3f2a-1b0c-9d8e7f6a5b4c",
    "name": "Evergain Avenue — Complete System API (Admin, Ground, Customer)",
    "description": "Full Postman collection for Evergain Avenue Indoor Football System covering Admin Auth & User Management, Ground & Slot Settings, and Customer Auth, Profile & Coupons.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "groundId",
      "value": "REPLACE_WITH_GROUND_ID",
      "type": "string"
    },
    {
      "key": "adminId",
      "value": "REPLACE_WITH_ADMIN_ID",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. System Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Checks API server status, environment, uptime, and MongoDB connectivity."
          }
        }
      ]
    },
    {
      "name": "1. Admin Auth & Management",
      "item": [
        {
          "name": "1.1 Seed Initial Super Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Super Admin\",\n  \"phone\": \"01700000000\",\n  \"password\": \"admin123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admins/seed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admins", "seed"]
            },
            "description": "Creates initial Super Admin user. Only works if 0 admins exist in DB."
          }
        },
        {
          "name": "1.2 Admin Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01700000000\",\n  \"password\": \"admin123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "admin", "login"]
            },
            "description": "Authenticates admin and sets `adminToken` httpOnly Cookie."
          }
        },
        {
          "name": "1.3 Get Current Admin (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/admin/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "admin", "me"]
            },
            "description": "Returns current logged in admin user info."
          }
        },
        {
          "name": "1.4 Create New Admin/Staff (Super Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Staff Manager\",\n  \"phone\": \"01711111111\",\n  \"password\": \"staff123456\",\n  \"role\": \"staff\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admins",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admins"]
            },
            "description": "Creates new admin/staff user. Super Admin role required."
          }
        },
        {
          "name": "1.5 Get All Admin Users (Super Admin Only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admins",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admins"]
            }
          }
        },
        {
          "name": "1.6 Update Admin User (Super Admin Only)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Staff Manager Updated\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admins/{{adminId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admins", "{{adminId}}"]
            }
          }
        },
        {
          "name": "1.7 Admin Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/admin/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "admin", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Ground & Slot Availability",
      "item": [
        {
          "name": "2.1 GET Slots (Public — No Auth Needed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/slots?date=2026-10-05",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "slots"],
              "query": [
                { "key": "date", "value": "2026-10-05", "description": "YYYY-MM-DD format" }
              ]
            },
            "description": "Calculates available slots and pricing (including 48h discount if applicable)."
          }
        },
        {
          "name": "2.2 POST Create Ground (Super Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Evergain Avenue Ground 1\",\n  \"location\": \"Bashundhara R/A, Dhaka\",\n  \"openingTime\": \"08:00\",\n  \"closingTime\": \"23:00\",\n  \"slotDurationMinutes\": 60,\n  \"pricePerSlot\": 800,\n  \"isActive\": true,\n  \"closures\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ground",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ground"]
            },
            "description": "Initial setup to create Ground record. Super Admin role required."
          }
        },
        {
          "name": "2.3 GET Ground Settings (Admin Only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ground/settings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ground", "settings"]
            }
          }
        },
        {
          "name": "2.4 PATCH Update Ground Settings (Super Admin Only)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pricePerSlot\": 850,\n  \"addClosures\": [\n    {\n      \"date\": \"2026-10-15\",\n      \"reason\": \"Turf Maintenance Day\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ground/settings/{{groundId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ground", "settings", "{{groundId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Customer Auth",
      "item": [
        {
          "name": "3.1 Customer Signup",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"phone\": \"01812345678\",\n  \"password\": \"user123456\",\n  \"email\": \"john@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/customer/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "customer", "signup"]
            },
            "description": "Registers new customer account (or upgrades guest booking phone)."
          }
        },
        {
          "name": "3.2 Customer Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01812345678\",\n  \"password\": \"user123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/customer/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "customer", "login"]
            },
            "description": "Authenticates customer and sets `customerToken` httpOnly Cookie."
          }
        },
        {
          "name": "3.3 Get Current Customer (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/customer/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "customer", "me"]
            }
          }
        },
        {
          "name": "3.4 Customer Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/customer/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "customer", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Customer Profile & Coupons",
      "item": [
        {
          "name": "4.1 Get Customer Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customer", "profile"]
            }
          }
        },
        {
          "name": "4.2 Update Customer Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe Updated\",\n  \"email\": \"john.updated@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customer", "profile"]
            },
            "description": "Updates customer profile. If profile completed after booking, awards ৳50 coupon."
          }
        },
        {
          "name": "4.3 Get Customer Active Coupons",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/coupons",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customer", "coupons"]
            },
            "description": "Gets all active unused discount coupons belonging to logged-in customer."
          }
        }
      ]
    }
  ]
}
