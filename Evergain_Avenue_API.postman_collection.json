    {
      "name": "5. OTP (Phone & Email Verification)",
      "item": [
        {
          "name": "5.1 Send OTP (Choose Channel: email or sms)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"email\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"01812345678\",\n  \"purpose\": \"signup\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/otp/send",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "otp", "send"]
            },
            "description": "Sends 6-digit OTP via chosen channel ('email' or 'sms'). Enforces 60s cooldown & 5min expiry."
          }
        },
        {
          "name": "5.2 Verify OTP Code",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"email\",\n  \"email\": \"john@example.com\",\n  \"otp\": \"123456\",\n  \"purpose\": \"signup\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/otp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "otp", "verify"]
            },
            "description": "Verifies 6-digit OTP code for the chosen channel (max 3 invalid attempts allowed)."
          }
        }
      ]
    },
    {
      "name": "6. Guest Booking & SSLCommerz Payment",
      "item": [
        {
          "name": "6.1 Create Guest Booking Request (15-min hold + SSLCommerz session)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groundId\": \"{{groundId}}\",\n  \"date\": \"2026-10-10\",\n  \"startTime\": \"18:00\",\n  \"name\": \"Rahim Ahmed\",\n  \"phone\": \"01799887766\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/request",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings", "request"]
            },
            "description": "Public guest booking request. Computes 48h early-bird discount if eligible, enforces max 1 pending hold per phone, creates 15-min PENDING booking, and returns SSLCommerz checkout URL."
          }
        },
        {
          "name": "6.2 SSLCommerz Success Callback (Validated Server-to-Server)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "tran_id", "value": "EAG_1750000000000_1234", "type": "text" },
                { "key": "val_id", "value": "MOCK_VAL_999", "type": "text" },
                { "key": "card_type", "value": "BKASH-BKASH", "type": "text" },
                { "key": "amount", "value": "450", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payment/sslcommerz/success?json=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payment", "sslcommerz", "success"],
              "query": [
                { "key": "json", "value": "true" }
              ]
            },
            "description": "SSLCommerz success redirect. Performs server-to-server validation, updates booking to BOOKED, clears hold, increments customer booking count."
          }
        },
        {
          "name": "6.3 SSLCommerz Fail Callback",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "tran_id", "value": "EAG_1750000000000_1234", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payment/sslcommerz/fail?json=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payment", "sslcommerz", "fail"],
              "query": [
                { "key": "json", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "6.4 SSLCommerz Cancel Callback",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "tran_id", "value": "EAG_1750000000000_1234", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payment/sslcommerz/cancel?json=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payment", "sslcommerz", "cancel"],
              "query": [
                { "key": "json", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "6.5 SSLCommerz Server-to-Server IPN Callback",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tran_id\": \"EAG_1750000000000_1234\",\n  \"val_id\": \"MOCK_VAL_999\",\n  \"status\": \"VALID\",\n  \"amount\": \"450\",\n  \"card_type\": \"BKASH-BKASH\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payment/sslcommerz/ipn",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payment", "sslcommerz", "ipn"]
            },
            "description": "Server-to-server IPN callback. Validates transaction via SSLCommerz validation API. Idempotent: safe to call multiple times."
          }
        }
      ]
    },
