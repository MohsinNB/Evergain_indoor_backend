{
  "info": {
    "_postman_id": "e9a8b7c6-d5e4-3f2a-1b0c-9d8e7f6a5b4c",
    "name": "Evergain Avenue — Complete System API (Admin, Ground, Booking, Customer)",
    "description": "Full Postman collection for Evergain Avenue Indoor Football System covering Auto-Seeded Super Admin Auth, Admin Management, Multi-Ground & Slot Settings, Admin Manual Booking, Customer Auth, Profile, Coupons & Admin Customer List.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "groundId",
      "value": "REPLACE_WITH_GROUND_ID",
      "type": "string"
    },
    {
      "key": "adminId",
      "value": "REPLACE_WITH_ADMIN_ID",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "REPLACE_WITH_BOOKING_ID",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. System Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Checks API server status, environment, uptime, and MongoDB connectivity."
          }
        }
      ]
    },
    {
      "name": "1. Admin Auth & Management",
      "item": [
        {
          "name": "1.1 Admin Login (by Email or Phone)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"superadmin1@evergainavenue.com\",\n  \"password\": \"admin123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "admin", "login"]
            },
            "description": "Log in auto-seeded Super Admin using Email or Phone. Sets `adminToken` httpOnly Cookie."
          }
        },
        {
          "name": "1.2 Get Current Admin (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/admin/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "admin", "me"]
            },
            "description": "Returns current logged in admin user info."
          }
        },
        {
          "name": "1.3 Create New Admin/Staff (Super Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Staff Manager\",\n  \"phone\": \"01711111111\",\n  \"email\": \"staff1@evergainavenue.com\",\n  \"password\": \"staff123456\",\n  \"role\": \"staff\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admins",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admins"]
            },
            "description": "Creates new admin/staff user. Super Admin role required."
          }
        },
        {
          "name": "1.4 Get All Admin Users (Super Admin Only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admins",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admins"]
            }
          }
        },
        {
          "name": "1.5 Update Admin User (Super Admin Only)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Staff Manager Updated\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admins/{{adminId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admins", "{{adminId}}"]
            }
          }
        },
        {
          "name": "1.6 Admin Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/admin/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "admin", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Ground, Slots & Admin Manual Bookings",
      "item": [
        {
          "name": "2.1 GET Active Grounds (Public — No Auth Needed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/grounds",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "grounds"]
            },
            "description": "Returns list of all active grounds so users can select a ground ID."
          }
        },
        {
          "name": "2.2 GET Slots by Ground & Date (Public — No Auth Needed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/slots?date=2026-10-05&groundId={{groundId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "slots"],
              "query": [
                { "key": "date", "value": "2026-10-05", "description": "YYYY-MM-DD format" },
                { "key": "groundId", "value": "{{groundId}}", "description": "Specific ground ID" }
              ]
            },
            "description": "Calculates available slots and pricing for the specified ground ID."
          }
        },
        {
          "name": "2.3 POST Create Ground (Super Admin or Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Evergain Avenue Ground 2\",\n  \"location\": \"Uttara, Dhaka\",\n  \"openingTime\": \"09:00\",\n  \"closingTime\": \"23:00\",\n  \"slotDurationMinutes\": 60,\n  \"pricePerSlot\": 900,\n  \"isActive\": true,\n  \"closures\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ground",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ground"]
            },
            "description": "Creates a new ground record."
          }
        },
        {
          "name": "2.4 GET All Grounds Settings (Admin Only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ground/settings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ground", "settings"]
            }
          }
        },
        {
          "name": "2.5 PATCH Update Ground Settings (Super Admin Only)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pricePerSlot\": 850,\n  \"addClosures\": [\n    {\n      \"date\": \"2026-10-15\",\n      \"reason\": \"Turf Maintenance Day\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ground/settings/{{groundId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ground", "settings", "{{groundId}}"]
            }
          }
        },
        {
          "name": "2.6 Admin Manual Booking / Block Slot (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groundId\": \"{{groundId}}\",\n  \"date\": \"2026-10-05\",\n  \"startTime\": \"18:00\",\n  \"customerName\": \"Walk-in Offline Customer\",\n  \"customerPhone\": \"01799999999\",\n  \"price\": 800,\n  \"paymentStatus\": \"paid\",\n  \"notes\": \"Offline cash payment at counter\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/admin-manual",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings", "admin-manual"]
            }
          }
        },
        {
          "name": "2.7 GET All Bookings (Admin Only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings?date=2026-10-05",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings"],
              "query": [
                { "key": "date", "value": "2026-10-05" }
              ]
            }
          }
        },
        {
          "name": "2.8 Admin Cancel Booking",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancelReason\": \"Customer requested cancellation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings", "{{bookingId}}", "cancel"]
            }
          }
        }
      ]
    },
